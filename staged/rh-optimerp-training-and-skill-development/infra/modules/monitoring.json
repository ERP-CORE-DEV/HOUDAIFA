      "type": "string",
      "metadata": {
        "description": "Prefix applied to every resource name."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for monitoring resources."
      }
    },
    "tags": {
      "type": "object",
      "metadata": {
        "description": "Resource tags."
      }
    },
    "logAnalyticsSku": {
      "type": "string",
      "defaultValue": "PerGB2018",
      "allowedValues": [
        "PerGB2018",
        "Free"
